# ── Hedera account ───────────────────────────────────────────────────────────
# Free testnet account: https://portal.hedera.com (faucet gives test HBAR).
HEDERA_OPERATOR_ID=0.0.xxxxxxx

# ECDSA private key — hex, 0x-prefixed. Signs both HSCS/EVM contract calls
# and (if you add it) Hedera SDK operations.
# ⚠ Must be ECDSA — ED25519 keys cannot sign EVM transactions via Hashio.
HEDERA_PRIVATE_KEY=0x...

# testnet (default) or mainnet — flips chain, RPC and Hashscan links.
HEDERA_NETWORK=testnet

# Optional override for the Hashio JSON-RPC endpoint.
# HEDERA_RPC_URL=https://testnet.hashio.io/api

# ── Deployed contracts (filled automatically by `npm run deploy`) ────────────
PASSPORT_CONTRACT=0x...
EVENTLOG_CONTRACT=0x...

# ── App ──────────────────────────────────────────────────────────────────────
# API port (default 3000)
# PORT=3000
