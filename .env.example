# Hedera testnet account (create at https://portal.hedera.com — free testnet HBAR)
HEDERA_OPERATOR_ID=0.0.xxxxxxx
# ECDSA private key (hex, 0x-prefixed) — works for both SDK and HSCS/EVM calls
HEDERA_PRIVATE_KEY=0x...
HEDERA_NETWORK=testnet
# Filled by `npm run deploy` — or set manually
PASSPORT_CONTRACT=0x...
EVENTLOG_CONTRACT=0x...
# Optional: HCS topic for attestation mirror (created by app on first run if unset)
ATTESTATION_TOPIC_ID=
